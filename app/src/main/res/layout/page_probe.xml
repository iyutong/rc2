<?xml version="1.0" encoding="utf-8"?>
<!-- 推送探针页：1920×1080 设计画布 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:paddingStart="36dp"
    android:paddingTop="20dp"
    android:paddingEnd="36dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/RcTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="推送探针" />

        <TextView
            android:id="@+id/probeSummary"
            style="@style/RcValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_weight="1"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/btnBackToRaw"
            style="@style/RcLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="报文"
            android:textColor="@color/rc_muted" />

        <TextView
            android:id="@+id/btnBackFromProbe"
            style="@style/RcLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="返回仪表盘" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="@color/rc_line" />

    <!-- 自定义订阅：任意 cmdSet / cmdId 抓包 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/RcTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="订阅" />

        <EditText
            android:id="@+id/probeCmdSet"
            style="@style/RcInput"
            android:layout_width="96dp"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:hint="set"
            android:imeOptions="actionNext" />

        <TextView
            style="@style/RcTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="/" />

        <EditText
            android:id="@+id/probeCmdId"
            style="@style/RcInput"
            android:layout_width="130dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:hint="cmd"
            android:imeOptions="actionDone" />

        <TextView
            android:id="@+id/btnProbeSub"
            style="@style/RcLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="订阅" />

        <TextView
            android:id="@+id/btnProbeUnsubAll"
            style="@style/RcLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="全部退订"
            android:textColor="@color/rc_muted" />

        <TextView
            android:id="@+id/probeSubState"
            style="@style/RcValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:ellipsize="end" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/probeSubChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/RcSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="签名分类 · cmd / 类型 / 长度 / 次数" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                android:layout_weight="1"
                android:scrollbars="vertical">

                <TextView
                    android:id="@+id/probeSigs"
                    style="@style/RcBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/rc_text"
                    android:textSize="18sp" />
            </ScrollView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:layout_weight="1.15"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/RcSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="推送流水 · 最新在下" />

            <ScrollView
                android:id="@+id/probeScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                android:layout_weight="1"
                android:scrollbars="vertical">

                <TextView
                    android:id="@+id/probeRing"
                    style="@style/RcBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="18sp" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:includeFontPadding="false"
        android:text="出现新 cmd 或新类型 = 事件在别的包里；行数增加但 hex 相同 = 同包重复上报；完全不动 = 不经 protocol 服务"
        android:textColor="@color/rc_muted"
        android:textSize="19sp" />

</LinearLayout>
