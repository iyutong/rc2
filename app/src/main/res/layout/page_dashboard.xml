<?xml version="1.0" encoding="utf-8"?>
<!--
    仪表盘：1920×1080 设计画布（Ui.normalizeDensity 已保证 1dp = 1 设计像素）
    纵向：顶栏 40 + 状态行 26 + 分隔 9 + 主体(weight 1) + 日志(weight 0.9)
    横向：左栏 1 : 中栏 1.1 : 右栏 1
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:paddingStart="36dp"
    android:paddingTop="20dp"
    android:paddingEnd="36dp"
    android:paddingBottom="20dp">

    <!-- ═══ 顶栏 ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/RcTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RC2 输入监视" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1.5" />

        <TextView
            android:id="@+id/stateText"
            style="@style/RcBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● 等待 MCU" />

        <TextView
            android:id="@+id/rateText"
            style="@style/RcTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:fontFamily="monospace"
            android:text="0 FPS  /  0 Hz" />
    </LinearLayout>

    <!-- 状态行：整行独占，永远不会被挤压 -->
    <TextView
        android:id="@+id/statusText"
        style="@style/RcTag"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="end"
        android:text="未连接 MCU"
        android:textSize="20sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@color/rc_line" />

    <!-- ═══ 主体三栏 ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- ─── 左栏 ─── -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/RcSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="左摇杆" />

                <TextView
                    android:id="@+id/stickLeftValue"
                    style="@style/RcValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="X +0.00  Y +0.00" />
            </LinearLayout>

            <local.rc2.xbox.ui.StickView
                android:id="@+id/stickLeft"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1.5" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/RcSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="左拨轮" />

                <TextView
                    android:id="@+id/dialLeftValue"
                    style="@style/RcValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="0x00 (0)" />
            </LinearLayout>

            <local.rc2.xbox.ui.DialView
                android:id="@+id/dialLeft"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="0.3" />

            <TextView
                android:id="@+id/keyC1"
                style="@style/RcKey"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:layout_weight="0.45"
                android:text="C1" />
        </LinearLayout>

        <!-- ─── 中栏 ─── -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_weight="1.1"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/RcSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="功能按键" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/keyRecord"
                    style="@style/RcKey"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="录像" />

                <TextView
                    android:id="@+id/keyShutter"
                    style="@style/RcKey"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="拍照" />
            </LinearLayout>

            <TextView
                android:id="@+id/keyRth"
                style="@style/RcKey"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="14dp"
                android:layout_weight="0.75"
                android:text="返航 / 暂停" />

            <!-- 飞行模式：标题行 + 三档方块 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/RcSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="飞行模式" />

                <TextView
                    android:id="@+id/modeRaw"
                    style="@style/RcValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="b2 —" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_weight="0.95"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/modeC"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:duplicateParentState="true"
                        android:includeFontPadding="false"
                        android:text="C"
                        android:textColor="@color/chip_text"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:duplicateParentState="true"
                        android:includeFontPadding="false"
                        android:text="平稳"
                        android:textColor="@color/chip_sub_text"
                        android:textSize="19sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/modeN"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="7dp"
                    android:layout_marginEnd="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:duplicateParentState="true"
                        android:includeFontPadding="false"
                        android:text="N"
                        android:textColor="@color/chip_text"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:duplicateParentState="true"
                        android:includeFontPadding="false"
                        android:text="普通"
                        android:textColor="@color/chip_sub_text"
                        android:textSize="19sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/modeS"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:duplicateParentState="true"
                        android:includeFontPadding="false"
                        android:text="S"
                        android:textColor="@color/chip_text"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:duplicateParentState="true"
                        android:includeFontPadding="false"
                        android:text="运动"
                        android:textColor="@color/chip_sub_text"
                        android:textSize="19sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ─── 右栏 ─── -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/RcSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="右摇杆" />

                <TextView
                    android:id="@+id/stickRightValue"
                    style="@style/RcValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="X +0.00  Y +0.00" />
            </LinearLayout>

            <local.rc2.xbox.ui.StickView
                android:id="@+id/stickRight"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1.5" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/RcSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="右拨轮" />

                <TextView
                    android:id="@+id/dialRightValue"
                    style="@style/RcValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="0x00 (0)" />
            </LinearLayout>

            <local.rc2.xbox.ui.DialView
                android:id="@+id/dialRight"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="0.3" />

            <TextView
                android:id="@+id/keyC2"
                style="@style/RcKey"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:layout_weight="0.45"
                android:text="C2" />
        </LinearLayout>
    </LinearLayout>

    <!-- ═══ 日志 ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="0.85"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="运行日志"
                android:textColor="@color/rc_text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/channelText"
                style="@style/RcTag"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="RX — RY — LY — LX — LT — RT —"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/btnRaw"
                style="@style/RcLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="原始报文 ›" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/logScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/logText"
                style="@style/RcBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </ScrollView>
    </LinearLayout>

</LinearLayout>
