<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="8dp"
    android:paddingEnd="14dp"
    android:paddingBottom="8dp">

    <!-- 顶栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="RC2 / 输入监视"
            android:textColor="@color/rc_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/stateText"
            style="@style/RcTag"
            android:text="● 等待 MCU"
            android:textColor="@color/rc_warn" />

        <TextView
            android:id="@+id/rateText"
            style="@style/RcTag"
            android:layout_marginStart="14dp"
            android:text="0 FPS / 0 Hz" />

        <TextView
            android:id="@+id/statusText"
            style="@style/RcTag"
            android:layout_marginStart="14dp"
            android:maxWidth="220dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="未连接 MCU" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:background="@color/rc_line" />

    <!-- 主体三栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- 左栏 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                style="@style/RcSection"
                android:text="左侧按键" />

            <TextView
                android:id="@+id/keyC1"
                style="@style/RcKey"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="C1" />

            <local.rc2.controls.StickView
                android:id="@+id/stickLeft"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                android:layout_weight="3.4" />

            <TextView
                android:id="@+id/stickLeftValue"
                style="@style/RcValue"
                android:layout_marginTop="2dp"
                android:text="X +0.00  Y +0.00" />

            <TextView
                style="@style/RcSection"
                android:layout_marginTop="4dp"
                android:text="左拨轮" />

            <local.rc2.controls.DialView
                android:id="@+id/dialLeft"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.7" />

            <TextView
                android:id="@+id/dialLeftValue"
                style="@style/RcValue"
                android:text="0x00 (0)" />
        </LinearLayout>

        <!-- 中栏 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1.12"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                style="@style/RcSection"
                android:text="功能按键" />

            <TextView
                android:id="@+id/keyRecord"
                style="@style/RcKey"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="录像" />

            <TextView
                android:id="@+id/keyShutter"
                style="@style/RcKey"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:text="拍照" />

            <!-- 飞行模式 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1.35"
                android:orientation="vertical">

                <TextView
                    style="@style/RcSection"
                    android:layout_height="0dp"
                    android:layout_weight="0.35"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="飞行模式"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/modeC"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="C"
                        android:textColor="@color/chip_text"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/modeN"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="N"
                        android:textColor="@color/chip_text"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/modeS"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="S"
                        android:textColor="@color/chip_text"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/modeRaw"
                    style="@style/RcValue"
                    android:layout_height="0dp"
                    android:layout_weight="0.5"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="b2 —"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/keyRth"
                style="@style/RcKey"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:text="返航 / 暂停" />
        </LinearLayout>

        <!-- 右栏 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                style="@style/RcSection"
                android:text="右侧按键" />

            <TextView
                android:id="@+id/keyC2"
                style="@style/RcKey"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="C2" />

            <local.rc2.controls.StickView
                android:id="@+id/stickRight"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                android:layout_weight="3.4" />

            <TextView
                android:id="@+id/stickRightValue"
                style="@style/RcValue"
                android:layout_marginTop="2dp"
                android:text="X +0.00  Y +0.00" />

            <TextView
                style="@style/RcSection"
                android:layout_marginTop="4dp"
                android:text="右拨轮" />

            <local.rc2.controls.DialView
                android:id="@+id/dialRight"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.7" />

            <TextView
                android:id="@+id/dialRightValue"
                style="@style/RcValue"
                android:text="0x00 (0)" />
        </LinearLayout>
    </LinearLayout>

    <!-- 日志 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="0.62"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="运行日志"
                android:textColor="@color/rc_muted"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/channelText"
                style="@style/RcTag"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="RX — RY — LY — LX — LT — RT —"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnRaw"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:includeFontPadding="false"
                android:padding="4dp"
                android:text="原始报文 ›"
                android:textColor="@color/rc_mint"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnProbe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="?android:attr/selectableItemBackground"
                android:includeFontPadding="false"
                android:padding="4dp"
                android:text="推送探针 ›"
                android:textColor="@color/rc_mint"
                android:textSize="13sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/logScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/logText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/rc_muted"
                android:textIsSelectable="false"
                android:textSize="12sp" />
        </ScrollView>
    </LinearLayout>

</LinearLayout>
