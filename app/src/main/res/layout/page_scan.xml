<?xml version="1.0" encoding="utf-8"?>
<!-- 全量报送页：cmdSet / cmdId 全部放开，统计所有到达本进程的协议包。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:paddingStart="36dp"
    android:paddingTop="20dp"
    android:paddingEnd="36dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/RcTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="全量报送" />

        <TextView
            android:id="@+id/scanSummary"
            style="@style/RcValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_weight="1"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/btnScanToggle"
            style="@style/RcLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="暂停" />

        <TextView
            android:id="@+id/btnBackToProbe"
            style="@style/RcLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="探针"
            android:textColor="@color/rc_muted" />

        <TextView
            android:id="@+id/btnBackFromScan"
            style="@style/RcLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="返回仪表盘" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="@color/rc_line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/RcSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="按接收量排序 · cmd / 类型 / 字节 / 次数 / 变化 / 最近样本" />

        <ScrollView
            android:id="@+id/scanScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/scanText"
                style="@style/RcBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/rc_text"
                android:textSize="18sp" />
        </ScrollView>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:includeFontPadding="false"
        android:text="本页打开时自动订阅全部 cmdSet / cmdId，离开即退订。若长期显示 0 包，说明服务端不支持 -1 通配。"
        android:textColor="@color/rc_muted"
        android:textSize="19sp" />

</LinearLayout>
